# KirimKarya — Production Environment Variables Template
NODE_ENV=production

# Better Auth Configuration
# Generate a secure key using: openssl rand -base64 32
BETTER_AUTH_SECRET=PRODUCTION_SECURE_SECRET_KEY
BETTER_AUTH_URL=https://api.kirimkarya.com/api/auth
WEB_URL=https://kirimkarya.com
PUBLIC_WEB_URL=https://kirimkarya.com
PUBLIC_API_URL=https://api.kirimkarya.com

# PostgreSQL Connection String
DATABASE_URL=postgres://db_user:db_password@postgres-host:5432/db_name

# Redis Connection URL
REDIS_URL=redis://redis-host:6379

# Production-grade S3 Object Storage (e.g. AWS S3, Cloudflare R2, Google Cloud Storage)
STORAGE_USER=your_s3_access_key
STORAGE_PASSWORD=your_s3_secret_key
STORAGE_ENDPOINT=https://your-s3-endpoint.com
STORAGE_BUCKET=production-kirimkarya-bucket
STORAGE_REGION=us-east-1

# SMTP Credentials for Delivery Notifications
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@kirimkarya.com
SMTP_PASS=production-smtp-secure-password

# OAuth Configuration (Optional)
GOOGLE_CLIENT_ID=google-production-client-id
GOOGLE_CLIENT_SECRET=google-production-client-secret

# Worker Port Configuration
WORKER_PORT=3001
